# SMTP Email Service Configuration
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=verified-sender@your-domain.com

# Optional Gmail fallback when SMTP_HOST is empty.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URLs (for verification email link)
FRONTEND_URL=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000
FRONTEND_LOCAL_URL=http://localhost:3000

# Database and other existing configs...
MONGODB_URI=mongodb://localhost:27017/homecare
JWT_SECRET=your-secret-key
